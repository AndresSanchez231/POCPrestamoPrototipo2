type Cliente {
    idCliente: Int
    nombreCompleto: String
    cedula: String
    ingresosMensuales: Float
    fechaNacimiento: String
    idPrestamo: String
    estado: Boolean
}

type Prestamo {
    _id: String
    idPrestamo: Int
    monto: Float
    tasaIntereses: Float
    fechaRegistro: String
    tipo: String
    estado: Boolean
    clientes: [Cliente]
}

type ClienteConPrestamo {
    idCliente: Int
    nombreCompleto: String
    cedula: String
    ingresosMensuales: Float
    fechaNacimiento: String
    estado: Boolean
    montoPrestamo: Float
    tipoPrestamo: String
}

input ClienteInput {
    idCliente: Int!
    nombreCompleto: String!
    cedula: String!
    ingresosMensuales: Float!
    fechaNacimiento: String!
    idPrestamo: String!
    estado: Boolean!
}

input PrestamoInput {
    idPrestamo: Int!
    monto: Float!
    tasaIntereses: Float!
    fechaRegistro: String!
    tipo: String!
    estado: Boolean!
}

type Query {
    prestamos: [Prestamo]
    prestamoPorId(idPrestamo: Int!): Prestamo  # <-- AHORA ES Int!
    prestamosPorTipoInmueble(tipoInmueble: String!): [Prestamo]
    clientes: [Cliente]
    clientesPorPrestamo(idPrestamo: String!): [Cliente]
    clientePorId(idCliente: Int!): Cliente
    clientesConDatosPrestamo: [ClienteConPrestamo]
}

type Mutation {
    addPrestamo(input: PrestamoInput!): Prestamo
    actualizarPrestamo(idPrestamo: Int!, input: PrestamoInput!): Prestamo
    eliminarPrestamo(idPrestamo: Int!): Boolean
    addCliente(input: ClienteInput!): Cliente
    actualizarCliente(idCliente: Int!, input: ClienteInput!): Cliente
    eliminarCliente(idCliente: Int!): Boolean
}