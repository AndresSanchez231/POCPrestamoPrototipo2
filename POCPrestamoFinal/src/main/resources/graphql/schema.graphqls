type Cliente {
    idCliente: Int
    nombreCompleto: String
    cedula: String
    ingresosMensuales: Float
    fechaNacimiento: String
    idPrestamo: String
    estado: Boolean
}

type Prestamo {
    _id: String
    idPrestamo: Int
    monto: Float
    tasaIntereses: Float
    fechaRegistro: String
    tipo: String
    estado: Boolean
    clientes: [Cliente]
}

type ClienteConPrestamo {
    idCliente: Int
    nombreCompleto: String
    cedula: String
    ingresosMensuales: Float
    fechaNacimiento: String
    estado: Boolean
    montoPrestamo: Float
    tipoPrestamo: String
}

# NUEVO TIPO: Pago (Clase C)
type Pago {
    idPago: Int
    monto: Float
    metodoPago: String
    fechaPago: String
    idPrestamo: Int
    estado: Boolean # <-- NUEVO
}

input ClienteInput {
    idCliente: Int!
    nombreCompleto: String!
    cedula: String!
    ingresosMensuales: Float!
    fechaNacimiento: String!
    idPrestamo: String!
    estado: Boolean!
}

input PrestamoInput {
    idPrestamo: Int!
    monto: Float!
    tasaIntereses: Float!
    fechaRegistro: String!
    tipo: String!
    estado: Boolean!
}

# NUEVO INPUT: PagoInput
input PagoInput {
    idPago: Int!
    monto: Float!
    metodoPago: String!
    fechaPago: String!
    idPrestamo: Int!
    estado: Boolean! # <-- NUEVO
}

type Query {
    prestamos: [Prestamo]
    prestamoPorId(idPrestamo: Int!): Prestamo
    prestamosPorTipoInmueble(tipoInmueble: String!): [Prestamo]
    clientes: [Cliente]
    clientesPorPrestamo(idPrestamo: String!): [Cliente]
    clientePorId(idCliente: Int!): Cliente
    clientesConDatosPrestamo: [ClienteConPrestamo]

    # NUEVAS QUERIES PARA PAGO
    pagosPorPrestamo(idPrestamo: Int!): [Pago]
    pagoPorId(idPago: Int!): Pago
}

type Mutation {
    addPrestamo(input: PrestamoInput!): Prestamo
    actualizarPrestamo(idPrestamo: Int!, input: PrestamoInput!): Prestamo
    eliminarPrestamo(idPrestamo: Int!): Boolean
    addCliente(input: ClienteInput!): Cliente
    actualizarCliente(idCliente: Int!, input: ClienteInput!): Cliente
    eliminarCliente(idCliente: Int!): Boolean

    # NUEVAS MUTATIONS PARA PAGO
    addPago(input: PagoInput!): Pago
    actualizarPago(idPago: Int!, input: PagoInput!): Pago
    eliminarPago(idPago: Int!): Boolean
}